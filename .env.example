# Copy this file to .env for command-line use. Never commit your real .env.
DISCORD_WEBHOOK_URL=
AI_PROVIDER=none
AI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ALLOW_PAID_AI=false
# Optional Ollama endpoint for the CLI. Container setup stores its own URL.
OLLAMA_BASE_URL=http://127.0.0.1:11434
